+ */
+#define APPROX_NS_PS		(1073741824) /* Approximate ns per second */
+#define JIFFY_NS		(APPROX_NS_PS / HZ)
+#define NS_TO_JIFFIES(TIME)	((TIME) / JIFFY_NS)
+#define HALF_JIFFY_NS		(APPROX_NS_PS / HZ / 2)
+/*
