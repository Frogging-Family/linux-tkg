 			goto out;
 
-		success = 1;
 		trace_sched_waking(p);
 		p->__state = TASK_RUNNING;
 		trace_sched_wakeup(p);
@@ -2218,14 +2267,11 @@ int try_to_wake_up(struct task_struct *p, unsigned int state, int wake_flags)
