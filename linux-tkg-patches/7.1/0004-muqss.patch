+
+static int cpu_period_quota_parse(char *buf, u64 *period_us_p, u64 *quota_us_p)
+{
+	char tok[21];	/* U64_MAX */
+
+	if (sscanf(buf, "%20s %llu", tok, period_us_p) < 1)
+		return -EINVAL;
+
+	if (sscanf(tok, "%llu", quota_us_p) < 1) {
+		if (!strcmp(tok, "max"))
+			*quota_us_p = U64_MAX;
+		else
+			return -EINVAL;
+	}
+
+	return 0;
+}
